# ---------------------------------------------------------------------------
# JobHunter AI — environment template
#
#   cp .env.example .env        (or just run ./run.sh — it generates secrets)
#
# Everything has a safe-by-default value: with an empty file the app runs in
# development mode with SQLite, no AI key, no outbound email and no automation.
# Production refuses to start with placeholder secrets (see ENVIRONMENT below).
#
# Style note: keep comments on their own line for keys that may be empty —
# `KEY=   # comment` would be read as the literal text "# comment".
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# Required in production. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
# SECRET_KEY signs sessions; ENCRYPTION_KEY derives the per-user vault keys.
SECRET_KEY=
ENCRYPTION_KEY=
# VAULT_KEY=            # legacy alias accepted for ENCRYPTION_KEY

# --- Database ---------------------------------------------------------------
# PostgreSQL is required in production (SQLite is fine for a single user).
DATABASE_URL=sqlite:///./jobhunter.db
# DATABASE_URL=postgresql+psycopg2://jobhunter:change-me@db:5432/jobhunter
ALLOW_SQLITE_IN_PROD=false
AUTO_MIGRATE=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth -------------------------------------------------------------------
AUTH_REQUIRED=true
ALLOW_REGISTRATION=false
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10
API_RATE_LIMIT_PER_MINUTE=600

# --- AI (OpenAI-compatible) -------------------------------------------------
# AI is a hard dependency: with no usable key the app is honest about it
# (state=blocked_needs_action, "AI blocked — action needed") instead of
# silently degrading. Transient outages pause the affected work and resume
# automatically when the provider is back.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RPM=60
AI_MAX_RETRIES=3
# How long to wait for the model to finish generating, per request (seconds).
# Heavy reasoning models legitimately take minutes on large tasks (resume
# parsing = thinking tokens + a multi-thousand-token JSON), so this is
# deliberately generous. Per-user override in Settings → AI API (Timeout).
# When hit, the failure is reported honestly as `timeout` — never
# `unreachable` — with the attempts spent and a billing caveat. Retries apply
# to connect failures and 429/5xx only: an expired generation wait is never
# retried automatically (each retry would spend and bill another generation).
AI_TIMEOUT=300
# TCP+TLS connect deadline inside the generation wait above. Kept short so a
# genuinely unreachable endpoint (wrong base_url, DNS/TLS failure) still fails
# fast with `unreachable` even though generations get minutes.
AI_CONNECT_TIMEOUT=10
AI_DAILY_TOKEN_BUDGET=0
# Output-token CEILING per request (the env-level default for the per-user
# `ai.max_output_tokens` setting in Settings → AI API). The gateway clamps
# every per-task starting budget (and the automatic escalation when a model's
# answer is truncated) to this value — it can never be exceeded. 16000 covers
# large documents + reasoning overhead.
AI_MAX_OUTPUT_TOKENS=16000
# Input-token budget per request (the env-level default for the per-user
# `ai.max_input_tokens` setting). Documents spliced into prompts are clamped
# to ~4 chars/token of this budget — an oversized document still produces a
# (shorter) honest request, flagged as `input_truncated` in the ledger; it is
# never rejected.
AI_MAX_INPUT_TOKENS=12000
# How often the AI watchdog re-probes availability and drains work that was
# paused during an outage (seconds). Set to 0 to disable the automatic
# resume (work then only resumes via POST /api/settings/ai/resume).
AI_WATCHDOG_INTERVAL_SECONDS=15

# --- Job discovery ----------------------------------------------------------
LIVE_SCRAPING_ENABLED=true
RESPECT_ROBOTS_TXT=true
PER_HOST_MIN_INTERVAL_SECONDS=1.0
MAX_CONCURRENT_FETCHES=4
INCLUDE_DEMO_POOL=false
ENABLED_SOURCES=
MAX_ATS_BOARDS_PER_RUN=12

# ATS board tokens (comma separated public boards, e.g. greenhouse:stripe)
GREENHOUSE_BOARD_TOKENS=
LEVER_BOARD_TOKENS=
ASHBY_BOARD_TOKENS=
WORKABLE_BOARD_TOKENS=
SMARTRECRUITERS_BOARD_TOKENS=
# WORKDAY_BOARD_TOKENS uses the form "host|tenant|site,host|tenant|site"
WORKDAY_BOARD_TOKENS=

# Partner APIs (optional — sources without keys stay disabled and say so)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Outbound fetch policy (SSRF guard). Allow-list internal hosts you really need.
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_ALLOW_PRIVATE=false

# --- Funding radar ----------------------------------------------------------
# sec_edgar | crunchbase | tracxn | imported | demo
FUNDING_PROVIDER=sec_edgar
# SEC requires a descriptive User-Agent, e.g. "JobHunter/2.0 you@example.com"
SEC_EDGAR_USER_AGENT=
CRUNCHBASE_API_KEY=
TRACXN_API_KEY=
FUNDING_IMPORT_URL=
ALLOW_SYNTHETIC_FUNDING_DATA=false
FUNDING_FRESHNESS_DAYS=45
FUNDING_LIMIT=18

# --- Contact discovery ------------------------------------------------------
HUNTER_API_KEY=
CLEARBIT_API_KEY=
APOLLO_API_KEY=
CONTACT_VERIFY_MX=true

# --- Email / outreach -------------------------------------------------------
EMAIL_SENDING_ENABLED=false
EMAIL_DRY_RUN=true
EMAIL_DAILY_LIMIT=40
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_NAME=
# CAN-SPAM: required before real sends are allowed
EMAIL_POSTAL_ADDRESS=
EMAIL_UNSUBSCRIBE_BASE_URL=
EMAIL_TRACKING_ENABLED=true
EMAIL_WEBHOOK_TOKEN=

# --- Browser autofill (needs requirements-autofill.txt + Playwright) --------
AUTOFILL_ENABLED=false
AUTOFILL_DRY_RUN=true
AUTOFILL_ALLOW_SUBMIT=false
AUTOFILL_HEADLESS=true
AUTOFILL_TIMEOUT_MS=45000

# --- Workers ----------------------------------------------------------------
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1.0
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# --- Observability & HTTP ---------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
ACCESS_LOG=true
METRICS_ENABLED=true
# Required in production while METRICS_ENABLED=true: /api/metrics is otherwise
# readable by anyone. Scrape with `Authorization: Bearer <token>`
# (?metrics_token= works too, but it leaks into access logs).
METRICS_TOKEN=
# Serve metrics on their own port instead of GET /api/metrics (recommended in
# production: the public route then 404s and this port can stay internal).
# 0 = keep using the API route. METRICS_HOST defaults to 127.0.0.1 (loopback);
# set it to 0.0.0.0 only inside a container network you control.
METRICS_PORT=9464
METRICS_HOST=127.0.0.1
# CORS_ORIGINS must list explicit origins in production (comma separated)
CORS_ORIGINS=
# ALLOWED_HOSTS must list your domain(s) in production (comma separated)
ALLOWED_HOSTS=

# --- Files ------------------------------------------------------------------
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
SCREENSHOT_DIR=./artifacts/screenshots
MAX_UPLOAD_MB=15

# --- Billing / SaaS Monetization --------------------------------------------
# manual (self-hosted, no payment), stripe (international), razorpay (India)
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
AI_CREDITS_MONTHLY_LIMIT=500000
AI_COST_DAILY_LIMIT_USD=10.0

# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=14
