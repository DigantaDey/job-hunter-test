# ---------------------------------------------------------------------------
# JobHunter AI — environment template
#
#   cp .env.example .env        (or just run ./run.sh — it generates secrets)
#
# Everything has a safe-by-default value: with an empty file the app runs in
# development mode with SQLite, no AI key, no outbound email and no automation.
# Production refuses to start with placeholder secrets (see ENVIRONMENT below).
#
# Style note: keep comments on their own line for keys that may be empty —
# `KEY=   # comment` would be read as the literal text "# comment".
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# Required in production. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
# SECRET_KEY signs sessions; ENCRYPTION_KEY derives the per-user vault keys.
SECRET_KEY=
ENCRYPTION_KEY=
# VAULT_KEY=            # legacy alias accepted for ENCRYPTION_KEY

# --- Database ---------------------------------------------------------------
# PostgreSQL is required in production (SQLite is fine for a single user).
DATABASE_URL=sqlite:///./jobhunter.db
# DATABASE_URL=postgresql+psycopg2://jobhunter:change-me@db:5432/jobhunter
ALLOW_SQLITE_IN_PROD=false
AUTO_MIGRATE=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth -------------------------------------------------------------------
AUTH_REQUIRED=true
ALLOW_REGISTRATION=false
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10
# Pre-auth login-failure throttle: MAX_LOGIN_ATTEMPTS failures per
# LOGIN_THROTTLE_WINDOW_SECONDS, per address. The window lives in a bounded LRU
# (LOGIN_THROTTLE_MAX_KEYS) whose *full* windows are pinned, so a spray of
# random addresses costs its own entries and cannot reset anybody else's lockout.
# Tighten these on an install that is being sprayed; counters are on
# GET /api/ops/status under "edge.login_throttle".
MAX_LOGIN_ATTEMPTS=8
LOGIN_THROTTLE_WINDOW_SECONDS=300
LOGIN_THROTTLE_MAX_KEYS=4096
API_RATE_LIMIT_PER_MINUTE=600
# Hard cap on distinct rate-limit buckets held in memory. The limiter runs
# before authentication, so its key set is attacker-influenced: past this cap the
# least recently used bucket is evicted (a flood of unique/junk credentials costs
# memory bounded by this number, never more). Raise it only if `evictions` under
# `edge.rate_limiter` on GET /api/ops/status climbs while real users get 429s.
RATE_LIMIT_MAX_KEYS=8192

# --- Reverse proxy / client IP ----------------------------------------------
# Which peers may tell us who the real client is. X-Forwarded-For is believed
# only when the *connecting peer* is listed here, and then only up to the
# rightmost hop that is not itself a proxy — so a direct client cannot choose the
# IP that rate limits, login-failure attribution and audit rows are keyed on.
# Empty (default) trusts nobody: the peer address is the client, which is correct
# with no proxy and fail-closed with one. Comma separated addresses or CIDRs,
# e.g. the compose network subnet or your load balancer's range:
#   TRUSTED_PROXIES=172.18.0.0/16
# `*` and 0.0.0.0/0 are refused in production (they hand the client IP back to
# whoever is connecting).
TRUSTED_PROXIES=
# uvicorn's own --proxy-headers allow-list (the image CMD reads this variable).
# Point it at the same proxy as TRUSTED_PROXIES; either one alone is enough, but
# half-configuring them makes one layer attribute every request to the proxy.
# Defaults to loopback, i.e. forwarded headers are ignored unless you opt in.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- AI (OpenAI-compatible) -------------------------------------------------
# AI is a hard dependency: with no usable key the app is honest about it
# (state=blocked_needs_action, "AI blocked — action needed") instead of
# silently degrading. Transient outages pause the affected work and resume
# automatically when the provider is back.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RPM=60
AI_MAX_RETRIES=3
# How long to wait for the model to finish generating, per request (seconds).
# Heavy reasoning models legitimately take minutes on large tasks (resume
# parsing = thinking tokens + a multi-thousand-token JSON), so this is
# deliberately generous. Per-user override in Settings → AI API (Timeout).
# When hit, the failure is reported honestly as `timeout` — never
# `unreachable` — with the attempts spent and a billing caveat. Retries apply
# to connect failures and 429/5xx only: an expired generation wait is never
# retried automatically (each retry would spend and bill another generation).
AI_TIMEOUT=300
# TCP+TLS connect deadline inside the generation wait above. Kept short so a
# genuinely unreachable endpoint (wrong base_url, DNS/TLS failure) still fails
# fast with `unreachable` even though generations get minutes.
AI_CONNECT_TIMEOUT=10
AI_DAILY_TOKEN_BUDGET=0
# Output-token CEILING per request (the env-level default for the per-user
# `ai.max_output_tokens` setting in Settings → AI API).
#   0     = unlimited → no clamp, the provider's own per-model maximum applies
#           (the shipped default: a fixed ceiling is what turned long job
#           descriptions + reasoning models into `truncated_response`, which
#           the UI then showed as "AI pending" beside a preliminary score).
#   N > 0 = clamp every outgoing max_tokens AND the automatic escalation on
#           truncation to N (a cost cap for operators who want one).
AI_MAX_OUTPUT_TOKENS=0 # 0=provider default
# Input-token budget per request (the env-level default for the per-user
# `ai.max_input_tokens` setting). Documents spliced into prompts are clamped
# to ~4 chars/token of this budget — an oversized document still produces a
# (shorter) honest request, flagged as `input_truncated` in the ledger; it is
# never rejected. 0 = unlimited: nothing is truncated client-side, so a long
# job description reaches the model whole (the provider still enforces its own
# context window and says so with a 400 the gateway reports honestly).
AI_MAX_INPUT_TOKENS=0
# How often the AI watchdog re-probes availability and drains work that was
# paused during an outage (seconds). Set to 0 to disable the automatic
# resume (work then only resumes via POST /api/settings/ai/resume).
AI_WATCHDOG_INTERVAL_SECONDS=15

# --- Job discovery ----------------------------------------------------------
LIVE_SCRAPING_ENABLED=true
RESPECT_ROBOTS_TXT=true
PER_HOST_MIN_INTERVAL_SECONDS=1.0
MAX_CONCURRENT_FETCHES=4
INCLUDE_DEMO_POOL=false
ENABLED_SOURCES=
MAX_ATS_BOARDS_PER_RUN=12

# ATS board tokens (comma separated public boards, e.g. greenhouse:stripe)
GREENHOUSE_BOARD_TOKENS=
LEVER_BOARD_TOKENS=
ASHBY_BOARD_TOKENS=
WORKABLE_BOARD_TOKENS=
RECRUITEE_BOARD_TOKENS=
SMARTRECRUITERS_BOARD_TOKENS=
PERSONIO_BOARD_TOKENS=
# WORKDAY_BOARD_TOKENS uses the form "host|tenant|site,host|tenant|site"
WORKDAY_BOARD_TOKENS=

# Partner APIs (optional — sources without keys stay disabled and say so)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Outbound fetch policy (SSRF guard). Allow-list internal hosts you really need.
# NOTE: OUTBOUND_ALLOW_PRIVATE relaxes the HTTP client only — the autofill browser
# still refuses loopback/link-local/metadata hosts, and reaches a private range only
# when that exact host is listed here.
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_ALLOW_PRIVATE=false

# Bounded in-process caches (the worker is long-lived and sweeps thousands of
# distinct URLs/hosts — none of these may grow without limit). Counters are on
# GET /api/ops/status under "outbound".
HTTP_CACHE_MAX_ENTRIES=128
HTTP_CACHE_MAX_BODY_BYTES=1000000
HTTP_HOST_STATE_MAX_ENTRIES=512
DNS_CACHE_MAX_ENTRIES=512
# Derived per-scope vault keys (one per user vault). Bounded for the same reason,
# and the TTL is what stops a rotated ENCRYPTION_KEY/VAULT_KEY from being
# shadowed by a stale derivation on a running process.
KEY_CACHE_MAX_ENTRIES=1024
KEY_CACHE_TTL_SECONDS=3600

# --- Funding radar ----------------------------------------------------------
# sec_edgar | search | crunchbase | tracxn | imported | demo
FUNDING_PROVIDER=sec_edgar
# Web-search provider for funding scans (optional). When configured, scans
# discover funding events through the search API below and never touch
# efts.sec.gov directly (its robots.txt disallows automated full-text search).
#   tavily - the Tavily search API, needs FUNDING_SEARCH_API_KEY
#   stub   - hermetic deterministic fixture (tests/dev, no network; its rows
#            are labelled unverified)
#   empty  - auto: tavily when a key is set, else the direct sec_edgar path
#            (which stays robots-checked; a robots block is reported honestly
#            as scan_failed with provider_errors.sec_edgar, never a 500).
FUNDING_SEARCH_PROVIDER=
FUNDING_SEARCH_API_KEY=
# SEC requires a descriptive User-Agent, e.g. "JobHunter/2.0 you@example.com"
SEC_EDGAR_USER_AGENT=
CRUNCHBASE_API_KEY=
TRACXN_API_KEY=
FUNDING_IMPORT_URL=
ALLOW_SYNTHETIC_FUNDING_DATA=false
FUNDING_FRESHNESS_DAYS=45
FUNDING_LIMIT=18
# Per-provider wall-clock budget for one scan (seconds). A hung provider is
# retried once on network errors, then reported in the scan's provider report —
# it never stalls the whole radar. The `search` provider's budget also covers
# its AI extraction pass — raise this if your model is slow.
FUNDING_PROVIDER_TIMEOUT_SECONDS=20
# How often opening the Funding page may trigger an *implicit* re-scan (hours).
# Independent of FUNDING_FRESHNESS_DAYS, which decides how old a funding event
# may be and still appear on the radar.
FUNDING_REFRESH_HOURS=12

# --- Contact discovery ------------------------------------------------------
HUNTER_API_KEY=
CLEARBIT_API_KEY=
APOLLO_API_KEY=
CONTACT_VERIFY_MX=true
# The MX probe is a blocking resolver call, so it runs on a worker thread and is
# capped twice: the resolver's own lifetime, and how many lookups may be in
# flight at once. A failed/timed-out probe is reported as "unknown", never as
# "invalid" — an unreachable resolver must not mark real addresses undeliverable.
CONTACT_MX_TIMEOUT_SECONDS=5.0
CONTACT_MX_MAX_CONCURRENT=8

# --- Email / outreach -------------------------------------------------------
EMAIL_SENDING_ENABLED=false
EMAIL_DRY_RUN=true
EMAIL_DAILY_LIMIT=40
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_NAME=
# CAN-SPAM: required before real sends are allowed
EMAIL_POSTAL_ADDRESS=
EMAIL_UNSUBSCRIBE_BASE_URL=
EMAIL_TRACKING_ENABLED=true
EMAIL_WEBHOOK_TOKEN=

# --- Browser autofill (needs requirements-autofill.txt + Playwright) --------
AUTOFILL_ENABLED=false
AUTOFILL_DRY_RUN=true
AUTOFILL_ALLOW_SUBMIT=false
AUTOFILL_HEADLESS=true
AUTOFILL_TIMEOUT_MS=45000

# --- Workers ----------------------------------------------------------------
# uvicorn worker processes for the API (the image CMD reads this). Keep it at 1:
# every budget this app enforces lives in process memory — the rate limiter, the
# AI token bucket and daily token budget, per-user AI workflow overrides loaded
# at boot, the metrics registry — so N workers means N independent copies:
# per-user limits are effectively multiplied by N, an override saved through the API reaches
# one worker, and /metrics covers whichever worker won the port. The app logs a
# warning at startup if you raise it. Scale with the standalone worker container
# below (and more API replicas behind a load balancer) instead — see
# docs/DEPLOYMENT.md §6.
WEB_CONCURRENCY=1
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1.0
WORKER_LEASE_SECONDS=120
# Per-item failure budget: a queue item is dead-lettered once the worker has
# recorded this many *handler failures*. Being claimed, being parked by an AI
# outage (and resumed), or losing a lease does not count against it.
WORKER_MAX_ATTEMPTS=3
# The worker supervisor respawns a slot that dies with an exception after
# this many seconds (doubled per consecutive crash of that slot, capped by
# WORKER_CRASH_BACKOFF_MAX_SECONDS). 0 = respawn immediately.
WORKER_RESPAWN_BACKOFF_SECONDS=0.25
# Upper bound for the respawn backoff above.
WORKER_CRASH_BACKOFF_MAX_SECONDS=2.0
# --- Auto mode (scheduled work, v2.2) ---------------------------------------
# How often the scheduler checks for users who switched "Settings → Auto mode"
# on and enqueues whatever is due. It runs as a child task of the worker, so it
# is supervised like the claim loops (crash => logged, counted, respawned with
# backoff) and it only ever *enqueues*: the queue, the retries, the AI-outage
# pause and the plan limits are the ones clicked runs already go through.
# This interval decides how sharply a cadence boundary is hit — NOT how often a
# workflow runs; that is the per-plan cadence table in
# backend/app/services/auto_scheduler.py (Pro+: discovery 2h, funding 6h,
# application prep 24h; Pro: discovery 12h, funding 24h; free: nothing).
# 0 disables auto mode process-wide: the task is never spawned, and the Settings
# card says so instead of pretending a sweep will happen.
AUTO_SCHEDULER_INTERVAL_SECONDS=300

# --- Observability & HTTP ---------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
ACCESS_LOG=true
METRICS_ENABLED=true
# Required in production while METRICS_ENABLED=true: /api/metrics is otherwise
# readable by anyone. Scrape with `Authorization: Bearer <token>`
# (?metrics_token= works too, but it leaks into access logs).
METRICS_TOKEN=
# Serve metrics on their own port instead of GET /api/metrics (recommended in
# production: the public route then 404s and this port can stay internal).
# 0 = keep using the API route. METRICS_HOST defaults to 127.0.0.1 (loopback);
# set it to 0.0.0.0 only inside a container network you control.
METRICS_PORT=9464
METRICS_HOST=127.0.0.1
# Hard cap on distinct label combinations (series) kept per metric name. A label
# value is a permanent series in the in-process registry, so callers must use
# bounded values (route templates, outcome codes, collapsed hosts); past the cap
# the least recently updated series is evicted and counted under `edge.registry`
# on GET /api/ops/status. A rising `evicted` means some caller is labelling on
# request-controlled data.
METRICS_MAX_SERIES_PER_METRIC=512
# CORS_ORIGINS must list explicit origins in production (comma separated)
CORS_ORIGINS=
# ALLOWED_HOSTS must list your domain(s) in production (comma separated)
ALLOWED_HOSTS=

# --- Files ------------------------------------------------------------------
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
SCREENSHOT_DIR=./artifacts/screenshots
MAX_UPLOAD_MB=15

# --- Billing / SaaS Monetization --------------------------------------------
# manual (self-hosted, no payment), stripe (international), razorpay (India)
BILLING_PROVIDER=manual
# The API key used by the backend (config field: STRIPE_API_KEY). The old
# example shipped this as STRIPE_SECRET_KEY, which Settings never read — an
# operator who copied the file believed they had configured Stripe while the
# app saw an empty key.
STRIPE_API_KEY=
# REQUIRED for verification: with BILLING_PROVIDER=stripe (or razorpay) and no
# webhook secret, POST /api/billing/webhooks/{stripe,razorpay} refuses every
# event (400; 503 in production) instead of skipping verification. The manual
# webhook always requires EMAIL_WEBHOOK_TOKEN (see Email section). Generate
# the secret in the provider dashboard and paste it here (whsec_... / the
# Razorpay webhook's secret).
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price/plan ids the webhooks map to plans. These mappings are the ONLY way a
# webhook event can change a plan: the event's price/plan id is looked up here
# (a "plan" field in the body is ignored by design).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
# Where the provider sends users after (or instead of) checkout.
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
# Free-plan trial granted on signup paths, and the manual-provider switches.
TRIAL_DAYS=7
ENABLE_FREE_TIER=true
FREE_TIER_AUTO_APPROVE=true


# --- Backups ----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=14
