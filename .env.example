# AI (OpenAI-compatible) — leave empty to run in offline/heuristic mode
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RPM=60
AI_TIMEOUT=30

# Live job discovery (public keyless APIs: Arbeitnow, Remotive).
# Set to false to use only the curated demo pool.
LIVE_SCRAPING_ENABLED=true
LIVE_SCRAPE_TIMEOUT=8

# Optional overrides
# DATABASE_URL=sqlite:////absolute/path/jobhunter.db
# UPLOAD_DIR=/absolute/path/uploads
# GENERATED_DIR=/absolute/path/generated
# VAULT_KEY=change-me-32-chars-min

# Funding radar (AI-driven; keywords auto-extracted from profile+resume+context)
# FUNDING_FRESHNESS_DAYS=45
# FUNDING_LIMIT=18

# Per-workflow AI override — configure in Settings UI, or seed via PUT /api/ai/config
# Example: {"resume_gen":{"base_url":"https://api.openai.com/v1","model":"gpt-4o","api_key":"sk-..."}}
